@model dynamic
<h2>Báo cáo</h2>
<p>Tổng số sự kiện: @Model.EventCount</p>
<p class="event-attendee-count-2" >Tổng số người tham gia: @Model.AttendeeCount</p>
<dd class="event-attendee-count">@Model.AttendeeCount</dd>

<h3>Sự kiện theo danh mục</h3>
<ul>
    @foreach (var item in Model.EventsByCategory)
    {
        <li>@item.CategoryName: @item.EventCount sự kiện</li>
    }
</ul>


<!-- JavaScript for SignalR -->
<script src="~/lib/microsoft-signalr/signalr.js"></script>
<script>

    const connection = new signalR.HubConnectionBuilder()
    .withUrl("/eventHub")
    .build();

    // Update attendee count for Report Page
    connection.on("ReceiveAttendeeNumberUpdate", (numberAttendeeUpdate) => {
        const countElement = document.querySelector(`event-attendee-count`);
        if (countElement){
            countElement.innerText = numberAttendeeUpdate;
        } else {
            console.log("Chua the bat duoc value can update")
        }
    });

  

